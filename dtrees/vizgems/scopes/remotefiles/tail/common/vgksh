
for exe in ./ksh /bin/ksh /usr/bin/ksh $(which ksh) ./ksh.*; do
    [[ ! -f $exe ]] && continue

    if [[ \
        $( $exe -c 'print ${.sh.version}') != \
        *20[0-9][0-9]-[0-9][0-9]-[0-9][0-9] \
    ]]; then
        continue
    fi

    [[ $exe == ./ksh ]] && break

    rm -f ./ksh
    ln -s $exe ./ksh
    break
done

if [[ ! -x ./ksh ]]; then
    print -u2 SWIFT ERROR cannot find working ksh
    exit 1
fi

SHELL=$PWD/ksh ./ksh "$@"
